{
  "$schema": "../../umbraco-package-schema.json",
  "name": "BaryoDev.Umbraco.Analytics",
  "version": "0.1.0",
  "allowTelemetry": false,
  "extensions": [
    {
      "type": "dashboard",
      "alias": "BaryoDev.Analytics.Dashboard",
      "name": "Analytics",
      "element": "/App_Plugins/BaryoDev.Analytics/analytics-dashboard.js",
      "weight": -10,
      "meta": {
        "label": "Analytics",
        "pathname": "analytics"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    }
  ]
}
