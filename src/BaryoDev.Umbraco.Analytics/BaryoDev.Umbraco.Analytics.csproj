<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>BaryoDev.Umbraco.Analytics</PackageId>
    <Version>0.1.0</Version>
    <Authors>BaryoDev</Authors>
    <Description>Cookie-free page view analytics for Umbraco 17, stored in the site's own database. No second database, no raw IP or User-Agent kept.</Description>
    <PackageTags>umbraco umbraco-marketplace analytics privacy page-views cookie-free</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/BaryoDev/BaryoDev.Umbraco.Analytics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BaryoDev/BaryoDev.Umbraco.Analytics</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.*" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
